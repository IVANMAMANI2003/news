{
    "scheduler": {
        "interval_hours": 1,
        "max_concurrent_jobs": 1,
        "timeout_minutes": 120,
        "retry_failed_jobs": true,
        "max_retries": 3,
        "retry_delay_minutes": 30
    },
    "scraping": {
        "mode": "incremental",
        "sources": {
            "diario_sin_fronteras": true,
            "los_andes": true,
            "pachamama": true,
            "puno_noticias": true
        }
    },
    "logging": {
        "level": "INFO",
        "file": "scheduler.log",
        "max_size_mb": 50,
        "backup_count": 5
    },
    "notifications": {
        "enabled": false,
        "email": {
            "smtp_server": "",
            "smtp_port": 587,
            "username": "",
            "password": "",
            "to_addresses": []
        },
        "webhook": {
            "url": "",
            "enabled": false
        }
    },
    "maintenance": {
        "cleanup_old_logs_days": 30,
        "cleanup_old_files_days": 7,
        "database_backup_enabled": false,
        "backup_interval_hours": 24
    }
}