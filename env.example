# Configuración de Base de Datos
DB_HOST=localhost
DB_PORT=5432
DB_NAME=news_scraper
DB_USER=postgres
DB_PASSWORD=123456

# Configuración de Redis
REDIS_URL=redis://localhost:6379/0

# Configuración de Scraping
SCRAPING_DELAY=1
SCRAPING_WORKERS=10
SCRAPING_TIMEOUT=30
SCRAPING_RETRIES=3
SCRAPING_INCREMENTAL=true
SCRAPING_MAX_ARTICLES=2000

# Configuración de Celery
CELERY_WORKER_CONCURRENCY=4
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_TASK_ACKS_LATE=true
CELERY_WORKER_MAX_TASKS_PER_CHILD=1000

# Fuentes de Noticias
SOURCE_SIN_FRONTERAS=true
SOURCE_LOS_ANDES=true
SOURCE_PACHAMAMA=true
SOURCE_PUNO_NOTICIAS=true

# Configuración de Salida
OUTPUT_CSV=true
OUTPUT_JSON=true
OUTPUT_DIR=data
OUTPUT_TIMESTAMP=true

# Configuración de Logging
LOG_LEVEL=INFO
LOG_FILE=unified_scraper.log
LOG_MAX_SIZE_MB=50
LOG_BACKUP_COUNT=10

# Notificaciones
NOTIFICATIONS_ENABLED=false

# Mantenimiento
MAINTENANCE_CLEANUP_LOGS_DAYS=30
MAINTENANCE_CLEANUP_FILES_DAYS=7
MAINTENANCE_DB_BACKUP=false
MAINTENANCE_BACKUP_INTERVAL=24

# AWS (para despliegue)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_EC2_INSTANCE_ID=
